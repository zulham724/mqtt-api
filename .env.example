# API Configuration
API_PORT=8000

# MQTT Mosquitto Broker Ports (external access)
TCP_PORT=1883
WEBSOCKET_PORT=9001

# MQTT Client Configuration (used by mqtt-api to connect to mosquitto)
# Note: MQTT_BROKER will be set to "mosquitto" (docker service name) automatically
MQTT_PORT=1883
MQTT_KEEPALIVE=60

# MQTT Authentication (optional)
MQTT_USERNAME=
MQTT_PASSWORD=
